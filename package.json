{
  "name": "bowling-kata",
  "version": "1.0.0",
  "description": "Online multiplayer bowling for phones",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-8787} pnpm --parallel --filter @bowling/server --filter @bowling/web dev",
    "build": "pnpm --filter @bowling/web --filter @bowling/server build",
    "start": "pnpm --filter @bowling/server start",
    "test": "vitest run --coverage",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "arch": "depcruise packages apps",
    "knip": "knip",
    "size": "node scripts/size.mjs",
    "prepare": "lefthook install",
    "check": "pnpm lint && pnpm typecheck && pnpm size && pnpm arch && pnpm knip && pnpm test"
  },
  "keywords": [
    "bowling",
    "kata",
    "tdd"
  ],
  "author": "",
  "license": "EUPL-1.2",
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/core": "^1.16.22",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
